{
  "version": "0.2",
  "language": "en-GB",
  "ignorePaths": [
    ".git",
    "node_modules",
    "dist",
    "**/*.csv",
    "package-lock.json",
    "uv.lock"
  ],
  "ignoreRegExpList": [
    "/https?:\\/\\/[^\\s)>\\]]+/g",
    "/`[^`\\n]+`/g",
    "/\\b[A-Z0-9]{6,}\\b/g"
  ],
  "words": [
    "automatable",
    "Casomo",
    "casomoltd",
    "HMRC",
    "PAAC"
  ]
}
